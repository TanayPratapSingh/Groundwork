# Copy to .env. Nothing here is required: with no key at all, the stack runs
# end to end on the deterministic offline provider, and every eval still
# produces real numbers against the real datasets.

# Enables live Claude calls. Without it, GROUNDWORK_PROVIDER falls back to
# "offline" automatically.
ANTHROPIC_API_KEY=

# Force a provider regardless of key presence: offline | anthropic
GROUNDWORK_PROVIDER=

# Gateway API keys, formatted "<key>:<tenant>,<key>:<tenant>".
# Generate real ones with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# These are examples and are refused by the gateway on purpose.
GROUNDWORK_API_KEYS=dev-key-analytics:analytics,dev-key-support:support

# Bind address for `make serve`
GROUNDWORK_HOST=127.0.0.1
GROUNDWORK_PORT=8000
