# Datasets are fetched, never committed. They carry their own licences and
# some run to hundreds of megabytes. `make data` reproduces them exactly;
# data/manifest.json records the sources and SHA-256 of every file.
data/raw/
data/processed/

# Evaluation output is regenerated on every run and is not committed, with one
# exception: the baseline is the contract the release gate compares against,
# so it has to be in version control or CI has nothing to check a pull request
# against. Note the pattern ignores the directory *contents* rather than the
# directory: git will not un-ignore a file inside an ignored directory.
artifacts/*
!artifacts/baseline.json

# Secrets
.env
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
